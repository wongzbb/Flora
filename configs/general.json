{
  "provider": {
    "model": "YOUR_MODEL_ID",
    "base_url": "https://your-provider.example/v1",
    "api_key_env": "OPENAI_API_KEY",
    "timeout": 120
  },
  "compiler": {"max_output_tokens": 12000, "max_repairs": 1},
  "general": {
    "search": {"provider": "duckduckgo"},
    "network": {"timeout": 25, "max_bytes": 4194304, "max_redirects": 5},
    "subagents": {"enabled": true, "max_children": 8, "max_parallel": 3},
    "require_report": false,
    "allow_commands": false,
    "storage_bytes": 268435456
  }
}
